# Copy to .env and fill in. .env is git-ignored: never commit real keys.
DB_DSN=mysql:host=localhost;dbname=Final;charset=utf8mb4
DB_USER=
DB_PASSWORD=

# Stripe test-mode keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen` locally, or the webhook endpoint's page in the Dashboard
STRIPE_WEBHOOK_SECRET=whsec_...
CURRENCY=sgd
SITE_URL=http://localhost:5173
